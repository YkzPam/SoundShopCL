{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "E3: instalar dependencias",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements.txt"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: revisar configuración",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "check"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: aplicar migraciones",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "migrate"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: cargar catálogo",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "cargar_catalogo"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: crear cuenta administradora",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "createsuperuser"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: configurar grupos de acceso",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "configurar_grupos"
            ],
            "problemMatcher": []
        },
        {
            "label": "E3: ejecutar pruebas",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "test",
                "core"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "E3: iniciar tienda y panel",
            "type": "process",
            "command": "${workspaceFolder}/venv/Scripts/python.exe",
            "args": [
                "manage.py",
                "runserver",
                "127.0.0.1:8000"
            ],
            "problemMatcher": [],
            "isBackground": true
        }
    ]
}
