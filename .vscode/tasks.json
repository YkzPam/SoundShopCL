{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: ejecutar servidor",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["manage.py", "runserver"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Django: ejecutar pruebas",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["manage.py", "test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Tailwind: compilar CSS",
      "type": "npm",
      "script": "build:css",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Tailwind: observar cambios",
      "type": "npm",
      "script": "watch:css",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
